DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_library
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional judge override; when absent, uses OPENAI_CHAT_MODEL.
# EVAL_JUDGE_MODEL=gpt-4o-mini
# DeepEval owns scored run history; agent answers remain in basic_result.json.
DEEPEVAL_LOCAL_STORE=sqlite
DEEPEVAL_RESULTS_FOLDER=evals/results
