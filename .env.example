DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_library
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Main model used for agent decisions and book answers.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Independent evaluation judge (the model used in the reviewed run 8).
# If omitted, the judge falls back to OPENAI_CHAT_MODEL.
EVAL_JUDGE_MODEL=gpt-5.4

# Required for hybrid reranking (enabled by default in agent/evals/search/ask).
# Use --no-rerank in CLI commands for the RRF baseline without Cohere.
COHERE_API_KEY=

# Optional LangSmith tracing; enable after setting LANGSMITH_API_KEY.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-library

# DeepEval owns scored run history; agent answers remain in basic_result.json.
DEEPEVAL_LOCAL_STORE=sqlite
DEEPEVAL_RESULTS_FOLDER=evals/results
